# PostgreSQL
POSTGRES_DB=flouze
POSTGRES_USER=flouze
POSTGRES_PASSWORD=changeme_in_production
DATABASE_URL=postgresql+asyncpg://flouze:changeme_in_production@db:5432/flouze

# Redis
REDIS_URL=redis://redis:6379/0

# JWT — generate keys:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth2 (optional for V1 native auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Exchange rates (exchangerate.host — free tier 250 req/month)
EXCHANGERATE_API_KEY=

# CORS — comma-separated JSON array
CORS_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:5173"]

# Exports
EXPORT_DIR=/app/exports

# Debug
DEBUG=false
